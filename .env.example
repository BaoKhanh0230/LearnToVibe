# Copy to .env and fill in the credentials from Google Cloud (Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
APP_URL=http://localhost:4173
PORT=4173

# Optional locally; required for production/free cloud hosting.
# Never commit real connection strings, keys, or credentials.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
